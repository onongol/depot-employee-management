# Copy to .env and fill in: cp .env.example .env
# Docker and Railway inject real env vars instead of reading this file.
# DJANGO_SETTINGS_MODULE must not go here - it's resolved before .env loads.


# --- Django core ---
# Required; generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me


# --- Database (MySQL): option A or B ---
# A: single URL, wins over every MYSQL_* part below.
# MYSQL_PUBLIC_URL=mysql://user:password@host:3306/dbname

# B: separate parts. Railway's MYSQLDATABASE/MYSQLUSER/... names also work.
MYSQL_DATABASE=my_db
MYSQL_USER=my_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Connection reuse: 60 for a remote database, 0 for a local one.
CONN_MAX_AGE=0


# --- docker compose MySQL container ---
# A different database from the local one above - don't reuse the same values.
MYSQL_DOCKER_ROOT_PASSWORD=change-me
MYSQL_DOCKER_DATABASE=my_db_docker
MYSQL_DOCKER_USER=my_user_docker
MYSQL_DOCKER_PASSWORD=change-me


# --- Hosts and CSRF ---
# Required in production (ImproperlyConfigured if empty), optional locally.
ALLOWED_HOSTS=.example.com
CSRF_TRUSTED_ORIGINS=https://example.com
# Testing the Docker image locally through the Caddy proxy (see README > Running
# (Docker)): add https://localhost:8443, or CSRF fails even though ALLOWED_HOSTS
# already covers localhost automatically in production.py.


# --- Local development only ---
# Only if npm isn't on PATH.
NPM_BIN_PATH=/usr/local/bin/npm
# Debug toolbar shows only for these IPs; add 172.17.0.1 inside Docker.
INTERNAL_IPS=127.0.0.1,::1


# --- Email (SMTP) ---
# Console locally, SMTP in production; override to send real mail from a dev machine.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com
# Production only - without it a hung SMTP connection pins a gunicorn worker.
EMAIL_TIMEOUT=5


# --- Production HTTPS: defaults are already secure, override only to debug ---
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true


# --- Sentry (production) ---
# Off until the DSN is set. DSN: Settings > Projects > <project> > Client Keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production


# --- Docker entrypoint (entrypoint.prod.sh) ---
# admin@admin.com superuser, created on first boot - change it after deploy.
DJANGO_SUPERUSER_PASSWORD=change-me
# GUNICORN_WORKERS=3
# DB_MAX_RETRIES=30
# DB_RETRY_INTERVAL=2
# Populates employees/works/piecework/salary history for the current week via
# `manage.py seed_demo` (idempotent). Local/demo use only - never set in prod.
# SEED_DEMO_DATA=true

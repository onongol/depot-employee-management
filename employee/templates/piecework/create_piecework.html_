{% extends "forms/create_form.html" %}

{% block title %}Create Piecework{% endblock %}

{% block form_alert %}
<div class="alert alert-dismissible alert-info" role="alert" aria-live="polite">
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  <h4 class="alert-heading">Heads up!</h4>
  If you add Piecework for the same: <strong>Employee(s), Work, Type Work, Work Date</strong>. Make sure this is necessary!
</div>
{% endblock %}

{% block form_fields %}
<script>
  const existingPieceworks = {{ existing_pieceworks_json|safe }};
</script>

<div class="form-group row mb-3">
  <label for="multiple-select-field" class="col-sm-2 col-form-label">Employee(s)</label>
  <div class="col-sm-10">
    <select
      class="form-select"
      id="multiple-select-field"
      name="employee"
      data-placeholder="Select Employee(s)"
      multiple
      aria-label="Select Employee(s)"
      required
    >
      {% for employee in form.employee.field.queryset %}
        <option value="{{ employee.pk }}">{{ employee }}</option>
      {% endfor %}
    </select>
    {% include "partials/field_errors.html" with field=form.employee %}
  </div>
</div>
<div class="form-group row mb-3">
  <label for="{{ form.work.id_for_label }}" class="col-sm-2 col-form-label">Work(s)</label>
  <div class="col-sm-10">
    <div class="card mb-3">
      <div class="card-header">
        Select Work(s)
      </div>
      <div class="card-body p-0" style="max-height: 11.5em; overflow-y: auto;">
        <table class="table table-sm table-hover table-bordered mb-0" aria-describedby="work_help">
          <thead>
            <tr>
              <th scope="col" style="width: 50px; text-align: center; font-size: 0.85em;">Select</th>
              <th scope="col" style="font-size: 0.85em;">Work</th>
              <th scope="col " style="width: 100px; text-align: center; font-size: 0.85em;">Amount</th>
            </tr>
          </thead>
          <tbody>
            {% for work in form.work.field.queryset %}
            <tr>
              <td class="align-middle text-center">
                <input
                  type="checkbox"
                  class="work-checkbox"
                  id="work_{{ work.pk }}"
                  name="work_selected"
                  value="{{ work.pk }}"
                  data-work-name="{{ work }}"
                  aria-labelledby="label_work_{{ work.pk }}"
                >
              </td>
              <td class="align-middle">
                <label id="label_work_{{ work.pk }}" for="work_{{ work.pk }}">{{ work }}</label>
              </td>
              <td>
                <input
                  type="number"
                  class="form-control amount-input"
                  name="amount_{{ work.pk }}"
                  min="0"
                  step="any"
                  disabled
                  aria-label="Amount for {{ work }}"
                >
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="card-footer text-muted">
        <div id="selected-works-footer" class="p-2" style="min-height:2em; background: #f8f9fa; font-size: 0.95em;">
          <strong>Selected:</strong> <span id="selected-works-list-footer">None</span>
        </div>
      </div>
    </div>
    {% include "partials/field_errors.html" with field=form.work %}
    {% include "partials/field_errors.html" with field=form.amount %}
  </div>
</div>
<div class="form-group row mb-3">
  <label for="{{ form.type_work.id_for_label }}" class="col-sm-2 col-form-label">Type Work</label>
  <div class="col-sm-10">
    {{ form.type_work }}
  </div>
</div>    
<div class="form-group row mb-3">
  <label for="{{ form.work_date.id_for_label }}" class="col-sm-2 col-form-label">Work Date</label>
  <div class="col-sm-10">
    {{ form.work_date }}
  </div>
</div>

<!-- Save Duplicate Modal -->
<div
  class="modal fade"
  id="saveDuplicateModal"
  tabindex="-1"
  aria-labelledby="saveDuplicateModalLabel"
  aria-modal="true"
  role="dialog"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="saveDuplicateModalLabel">Duplicate Entry</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        This employee(s) <strong id="modal-employee"></strong> has already added such work <strong id="modal-work"></strong> type <strong id="modal-type-work"></strong> on this date <strong id="modal-work-date"></strong>!
        Are you sure you want to save?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="confirmSaveBtn">Yes, save</button>
        <a href="{{ cancel_url }}" class="btn btn-secondary">Cancel</a>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("create_form");
    let allowSubmit = false;

    form.addEventListener("submit", function (event) {
      if (allowSubmit) {
        allowSubmit = false;
        return; // allow form to submit
      }

      // Get all selected employees (multi-select)
      const employeeSelect = form.querySelector('[name="employee"]');
      const employees = Array.from(employeeSelect.selectedOptions).map(opt => opt.value);

      // Get all selected works (checkboxes)
      const works = Array.from(form.querySelectorAll('.work-checkbox:checked')).map(cb => cb.value);

      // Get type work
      const type_work = form.querySelector('[name="type_work"]').value;

      // Get work date
      const work_date = form.querySelector('[name="work_date"]').value;

      // Check for duplicate for any combination
      const duplicate = existingPieceworks.some(
        (item) =>
          employees.includes(String(item.employee_id)) &&
          works.includes(String(item.work_id)) &&
          String(item.type_work) === String(type_work) &&
          String(item.work_date) === String(work_date)
      );

      if (duplicate) {
        event.preventDefault();

        // Fill modal fields
        document.getElementById('modal-employee').textContent =
          Array.from(employeeSelect.selectedOptions).map(opt => opt.text).join(', ');
        document.getElementById('modal-work').textContent =
          Array.from(form.querySelectorAll('.work-checkbox:checked')).map(cb => cb.getAttribute('data-work-name')).join(', ');
        document.getElementById('modal-type-work').textContent =
          form.querySelector('[name="type_work"]').selectedOptions
            ? form.querySelector('[name="type_work"]').selectedOptions[0].text
            : form.querySelector('[name="type_work"]').value;
        document.getElementById('modal-work-date').textContent = work_date;

        const saveModal = new bootstrap.Modal(document.getElementById('saveDuplicateModal'));
        saveModal.show();

        document.getElementById('confirmSaveBtn').onclick = function () {
          allowSubmit = true;
          saveModal.hide();
          form.submit();
        };
      }
      // else, allow normal submit
    });

    // Enable/disable amount input based on checkbox
    document.querySelectorAll('.work-checkbox').forEach(function (checkbox) {
      checkbox.addEventListener('change', function () {
        const amountInput = this.closest('tr').querySelector('.amount-input');
        amountInput.disabled = !this.checked;
        if (!this.checked) {
          amountInput.value = '';
        }

        // Update selected works display
        const selectedWorksList = document.getElementById('selected-works-list');
        const selectedWorks = Array.from(document.querySelectorAll('.work-checkbox:checked'))
          .map(cb => cb.getAttribute('data-work-name'));
        selectedWorksList.textContent = selectedWorks.length > 0 ? selectedWorks.join(', ') : 'None';

        // Update selected works display in footer
        const selectedWorksListFooter = document.getElementById('selected-works-list-footer');
        selectedWorksListFooter.textContent = selectedWorks.length > 0 ? selectedWorks.join(', ') : 'None';
      });
    });

    function updateSelectedWorksFooter() {
      const selectedWorksList = document.getElementById('selected-works-list-footer');
      const selectedWorks = Array.from(document.querySelectorAll('.work-checkbox:checked'))
        .map(cb => {
          const workName = cb.getAttribute('data-work-name');
          const amountInput = cb.closest('tr').querySelector('.amount-input');
          const amount = amountInput && amountInput.value ? amountInput.value : '0';
          return `${workName} (${amount})`;
        });
      selectedWorksList.textContent = selectedWorks.length > 0 ? selectedWorks.join(', ') : 'None';
    }

    document.querySelectorAll('.work-checkbox').forEach(function (checkbox) {
      checkbox.addEventListener('change', updateSelectedWorksFooter);
    });
    document.querySelectorAll('.amount-input').forEach(function (input) {
      input.addEventListener('input', updateSelectedWorksFooter);
    });

    // Initialize on page load
    updateSelectedWorksFooter();
  });
</script>

<!-- Select2 -->
<script>
  $(document).ready(function() {
    $('#multiple-select-field').select2({
      theme: "bootstrap-5",
      width: $(this).data('width') ? $(this).data('width') : $(this).hasClass('w-100') ? '100%' : 'style',
      placeholder: $(this).data('placeholder'),
      closeOnSelect: false,
    });
  });
</script>

{% endblock %}
{% extends "base.html" %}

{% block title %}Employee Salary List{% endblock %}

{% block content %}
<div class="d-flex justify-content-between mb-3">
  <h2 id="employee-salary-list-title">Employee Salary List</h2>
</div>

<!-- Filter Form -->
<form method="get" class="mb-3" aria-labelledby="employee-salary-list-title">
  <div class="row">
    <div class="col">
      <label for="filter-employee-id" class="visually-hidden">Employee ID</label>
      <input
        type="number"
        name="employee_id"
        id="filter-employee-id"
        class="form-control"
        placeholder="Employee ID"
        value="{{ filters.employee_id }}"
        min="1"
      />
    </div>
    <div class="col">
      <label for="filter-employee-name" class="visually-hidden">Employee Name</label>
      <input
        type="text"
        name="employee_name"
        id="filter-employee-name"
        class="form-control"
        placeholder="Employee Name"
        value="{{ filters.employee_name }}"
      />
    </div>
    <div class="col">
      <label for="filter-department" class="visually-hidden">Department</label>
      <select name="department" id="filter-department" class="form-control">
        <option value="">All Departments</option>
        {% for department in departments %}
        <option value="{{ department }}" {% if filters.department == department %}selected{% endif %}>
          {{ department }}
        </option>
        {% endfor %}
      </select>
    </div>
    <div class="col">
      <label for="filter-job-title" class="visually-hidden">Job Title</label>
      <select name="job_title" id="filter-job-title" class="form-control">
        <option value="">All Job Titles</option>
        {% for title in job_titles %}
        <option value="{{ title }}" {% if filters.job_title == title %}selected{% endif %}>
          {{ title }}
        </option>
        {% endfor %}
      </select>
    </div>
    <div class="col">
      <label for="filter-month" class="visually-hidden">Month</label>
      <select name="month" id="filter-month" class="form-control">
        <option value="">All Month</option>
        {% for value, label in MONTH_CHOICES %}
        <option value="{{ value }}" {% if filters.month == value|stringformat:'d' %}selected{% endif %}>
          {{ label }}
        </option>
        {% endfor %}
      </select>
    </div>
    <div class="col">
      <label for="filter-year" class="visually-hidden">Year</label>
      <select name="year" id="filter-year" class="form-control">
        <option value="" {% if not filters.year %}selected{% endif %}>All Years</option>
        <option value="{{ current_year }}" {% if filters.year == current_year|stringformat:'d' %}selected{% endif %}>
          {{ current_year }}
        </option>
        {% for year in years %}
        {% if year != current_year %}
        <option value="{{ year }}" {% if filters.year == year %}selected{% endif %}>
          {{ year }}
        </option>
        {% endif %}
        {% endfor %}
      </select>
    </div>
    <div class="col">
      <button type="submit" class="btn btn-light">Filter</button>
    </div>
  </div>
</form>

<!-- Employee Salary Table -->
<table class="table table-bordered table-striped">
  <thead class="table-dark">
    <tr>
      <th>#</th>
      <th>
        <a href="?order_by=employee_id&direction={% if request.GET.order_by == 'employee_id' and request.GET.direction == 'asc' %}desc{% else %}asc{% endif %}" class="sorting-link">
          Employee ID
          <span class="sorting-arrows">
            <span class="{% if request.GET.order_by == 'employee_id' and request.GET.direction == 'asc' %}active{% else %}inactive{% endif %}">▲</span>
            <span class="{% if request.GET.order_by == 'employee_id' and request.GET.direction == 'desc' %}active{% else %}inactive{% endif %}">▼</span>
          </span>
        </a>
      </th>
      <th>Employee Name</th>
      <th>Department</th>
      <th>Job Title</th>
      <th>Rank</th>
      <th>Salary Month</th>
      <th>Total Amount Price</th>
      <th>Total Salary</th>
      <th>
        <a href="?order_by=month&direction={% if request.GET.order_by == 'month' and request.GET.direction == 'asc' %}desc{% else %}asc{% endif %}" class="sorting-link">
          Month
          <span class="sorting-arrows">
            <span class="{% if request.GET.order_by == 'month' and request.GET.direction == 'asc' %}active{% else %}inactive{% endif %}">▲</span>
            <span class="{% if request.GET.order_by == 'month' and request.GET.direction == 'desc' %}active{% else %}inactive{% endif %}">▼</span>
          </span>
        </a>
      </th>
      <th>
        <a href="?order_by=year&direction={% if request.GET.order_by == 'year' and request.GET.direction == 'asc' %}desc{% else %}asc{% endif %}" class="sorting-link">
          Year
          <span class="sorting-arrows">
            <span class="{% if request.GET.order_by == 'year' and request.GET.direction == 'asc' %}active{% else %}inactive{% endif %}">▲</span>
            <span class="{% if request.GET.order_by == 'year' and request.GET.direction == 'desc' %}active{% else %}inactive{% endif %}">▼</span>
          </span>
        </a>
      </th>
    </tr>
  </thead>
  <tbody>
    {% if employee_salaries %}
    {% for employee_salary in employee_salaries %}
    <tr>
      <td>{{ forloop.counter }}</td>
      <td>{{ employee_salary.employee.employee_id }}</td>
      <td>{{ employee_salary.employee.name }}</td>
      <td>{{ employee_salary.employee.department }}</td>
      <td>{{ employee_salary.employee.job_title }}</td>
      <td>{{ employee_salary.employee.rank }}</td>
      <td>{{ employee_salary.monthly_salary.salary_month }}</td>
      <td>{{ employee_salary.total_piecework_amount }}</td>
      <td>{{ employee_salary.total_salary }}</td>
      <td>{{ employee_salary.monthly_salary.get_month_display }}</td>
      <td>{{ employee_salary.monthly_salary.year }}</td>
    </tr>
    {% endfor %}
    {% else %}
    <tr>
      <td colspan="11" class="text-center">No employee salary records found...</td>
    </tr>
    {% endif %}
  </tbody>
</table>

<!-- Include Pagination -->
<nav aria-label="Employee salary list pagination">
  {% include "partials/pagination.html" %}
</nav>

<div class="d-flex flex-column" style="max-width: 150px;">
  <!-- Export Button Excel -->
  <a
    href="{% url 'export_employee_salaries_excel' %}?employee_id={{ filters.employee_id }}&employee_name={{ filters.employee_name }}&department={{ filters.department }}&job_title={{ filters.job_title }}&month={{ filters.month }}&year={{ filters.year }}"
    class="btn btn-success export-excel-btn mb-2"
    role="button"
    aria-label="Download filtered employee salaries as Excel"
  >
    Download Excel
  </a>

  <!--  Export Button PDF -->
  <a 
    href="{% url 'export_employee_salaries_pdf' %}?employee_id={{ filters.employee_id }}&employee_name={{ filters.employee_name }}&department={{ filters.department }}&job_title={{ filters.job_title }}&month={{ filters.month }}&year={{ filters.year }}" 
    class="btn btn-danger export-pdf-btn mb-2"
    role="button"
    aria-label="Download filtered employee salaries as PDF" 
    target="_blank"
  >
    Download PDF
  </a>
</div>

{% endblock %}